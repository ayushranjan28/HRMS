generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  EMPLOYEE
  HR_ADMIN
}

enum AttendanceStatus {
  PRESENT
  HALF_DAY
  ABSENT
  LEAVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveType {
  PAID_TIME_OFF
  SICK_LEAVE
  UNPAID_LEAVE
  COMP_OFF
}

enum ComponentCategory {
  EARNING
  DEDUCTION
}

enum CalculationType {
  FIXED
  PERCENTAGE
}

enum CalculationBase {
  WAGE
  BASIC
}

enum DocumentType {
  RESUME
  CERTIFICATE
  ID_PROOF
  OTHER
}

enum NotificationType {
  LEAVE
  ATTENDANCE
  PAYROLL
  ANNOUNCEMENT
  GENERAL
}

enum EventType {
  MEETING
  HOLIDAY
  BIRTHDAY
  OTHER
}

// ============================================================
// USER
// ============================================================

model User {
  id           String   @id @default(uuid())
  employeeId   String   @unique
  fullName     String
  email        String   @unique
  passwordHash String
  role         Role     @default(EMPLOYEE)

  department   String?
  jobTitle     String?
  location     String?
  avatarUrl    String?

  // Reporting manager
  managerId    String?
  manager      User?    @relation("ManagerEmployees", fields: [managerId], references: [id])
  employees    User[]   @relation("ManagerEmployees")

  // Relations
  attendance      Attendance[]
  leaveRequests   LeaveRequest[]
  leaveBalances   LeaveBalance[]
  payrolls        Payroll[]
  privateInfo     PrivateInfo?
  salaryStructure SalaryStructure?
  documents       Document[]
  notifications   Notification[]
  calendarEvents  CalendarEvent[] @relation("UserEvents")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([department])
  @@index([managerId])
}

// ============================================================
// PRIVATE / PERSONAL INFORMATION
// ============================================================

model PrivateInfo {
  id              String   @id @default(uuid())

  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  dateOfBirth     DateTime? @db.Date
  residingAddress String?
  nationality     String?
  personalEmail   String?
  gender          String?
  maritalStatus   String?
  dateOfJoining   DateTime? @db.Date

  // Bank information
  accountNumber   String?
  bankName        String?
  ifscCode        String?

  // Indian employment information
  panNumber       String?
  uanNumber       String?
  employeeCode    String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================
// ATTENDANCE
// ============================================================

model Attendance {
  id         String           @id @default(uuid())

  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  date       DateTime         @db.Date
  checkIn    DateTime?
  checkOut   DateTime?
  status     AttendanceStatus @default(ABSENT)

  workHours  Decimal          @default(0) @db.Decimal(6, 2)
  extraHours Decimal          @default(0) @db.Decimal(6, 2)

  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@index([userId, date])
}

// ============================================================
// LEAVE
// ============================================================

model LeaveRequest {
  id            String       @id @default(uuid())

  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  type          LeaveType
  startDate     DateTime     @db.Date
  endDate       DateTime     @db.Date
  days          Decimal      @db.Decimal(5, 2)
  reason        String
  status        LeaveStatus  @default(PENDING)

  attachmentUrl String?
  adminComment  String?

  appliedOn     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId])
  @@index([status])
  @@index([startDate, endDate])
}

model LeaveBalance {
  id        String    @id @default(uuid())

  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      LeaveType
  totalDays Decimal   @db.Decimal(6, 2)
  usedDays  Decimal   @default(0) @db.Decimal(6, 2)
  year      Int

  @@unique([userId, type, year])
}

// ============================================================
// SALARY STRUCTURE
// ============================================================

model SalaryStructure {
  id                String   @id @default(uuid())

  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  monthlyWage       Decimal  @db.Decimal(12, 2)
  yearlyWage        Decimal  @db.Decimal(12, 2)

  workingDaysPerWeek Int     @default(5)
  breakHours         Decimal @default(1) @db.Decimal(4, 2)

  components        SalaryComponent[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ============================================================
// SALARY COMPONENTS
// ============================================================

model SalaryComponent {
  id               String          @id @default(uuid())

  salaryStructureId String
  salaryStructure   SalaryStructure @relation(
    fields: [salaryStructureId],
    references: [id],
    onDelete: Cascade
  )

  name             String
  category         ComponentCategory

  calculationType  CalculationType
  calculationBase  CalculationBase?

  value            Decimal         @db.Decimal(12, 2)
  calculatedAmount Decimal         @default(0) @db.Decimal(12, 2)

  description      String?

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([salaryStructureId])
}

// ============================================================
// PAYROLL
// ============================================================

model Payroll {
  id              String   @id @default(uuid())

  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  month           Int
  year            Int

  grossSalary     Decimal  @default(0) @db.Decimal(12, 2)
  totalDeductions Decimal  @default(0) @db.Decimal(12, 2)
  netSalary       Decimal  @default(0) @db.Decimal(12, 2)

  paidOn          DateTime? @db.Date

  items           PayrollItem[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, month, year])
  @@index([year, month])
}

model PayrollItem {
  id          String   @id @default(uuid())

  payrollId   String
  payroll     Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  name        String
  category    ComponentCategory
  amount      Decimal  @db.Decimal(12, 2)

  createdAt   DateTime @default(now())

  @@index([payrollId])
}

// ============================================================
// DOCUMENTS
// ============================================================

model Document {
  id          String       @id @default(uuid())

  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  type        DocumentType
  fileUrl     String

  uploadedAt  DateTime     @default(now())

  @@index([userId])
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id          String           @id @default(uuid())

  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        NotificationType
  title       String
  message     String
  isRead      Boolean          @default(false)

  createdAt   DateTime         @default(now())

  @@index([userId, isRead])
}

// ============================================================
// CALENDAR EVENTS
// ============================================================

model CalendarEvent {
  id          String    @id @default(uuid())

  userId      String?
  user        User?     @relation("UserEvents", fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?
  type        EventType

  startTime   DateTime
  endTime     DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([startTime])
  @@index([userId])
}

// ============================================================
// ANNOUNCEMENTS
// ============================================================

model Announcement {
  id          String   @id @default(uuid())

  title       String
  message     String
  publishedAt DateTime @default(now())
  expiresAt   DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([publishedAt])
}